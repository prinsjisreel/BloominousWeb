{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer order details.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "payment_method": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping_fee": { "type": "number" },
        "total_price": { "type": "number" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "paid", "shipped", "delivered", "cancelled"] },
        "type": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "payment_status": { "type": "string" },
        "paidAt": { "type": "string", "format": "date-time" },
        "timestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "total_price", "status"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Store branch location and info.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      }
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Product in a branch's inventory.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Global orders collection."
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "List of store branches."
    },
    "/branches/{branchId}/inventory/{productId}": {
      "schema": "InventoryItem",
      "description": "Branch-specific products."
    },
    "/test/connection": {
      "schema": { "type": "object", "properties": {} },
      "description": "Connection test document."
    }
  }
}
